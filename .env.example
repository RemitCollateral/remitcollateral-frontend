# mock | live
NEXT_PUBLIC_API_MODE=mock

# Backend API base URL, used when NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Stellar network the guarantor wallet must be on
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional, local dev only: proxy /api-proxy/* to a deployed backend whose CORS
# allowlist does not include localhost. Set NEXT_PUBLIC_API_URL=/api-proxy too.
# DEV_API_PROXY_TARGET=https://remitcollateral-backend.onrender.com/api/v1
